# Copy to .env.local for local development. On Vercel, set these per environment
# (Preview -> dev backends, Production -> prod backends).
# NEXT_PUBLIC_ values are embedded in the browser bundle: never put secrets here.
# The Supabase anon key is meant to be public; access is enforced by RLS.

# n8n webhook base URL (no trailing slash)
NEXT_PUBLIC_N8N_WEBHOOK_BASE=https://your-n8n.cloudfy.live/webhook

# Supabase project URL and anon (public) key
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase.cloudfy.live
NEXT_PUBLIC_SUPABASE_ANON_KEY=
